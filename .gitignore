# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Node (presentation/)
node_modules/

# Scratch / logs (terminal capture files used during deploys)
*.log
_*.log
_*.txt
_*.py
_*.json

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Generated dataset — fully reproducible via `python src/generate_data.py` (seed=42).
# Committing 12k CSV rows + 1.5k text files would bloat every diff for zero benefit.
data/raw/

# Video capture working files (marketing/record_tour.py).
# _auth.json holds live MSAL tokens for the signed-in operator; _capture/ and _frames/ are
# intermediate renders. Only the finished mp4 is meant to be tracked.
marketing/_auth.json
marketing/_capture/
marketing/_frames/

# Supervision run logs -- contain live agent answers (real figures, real entity names).
# Observations belong in the brain, redacted; raw answers do not belong in git.
data/supervision/

# Environment-specific — contain tenant / workspace / item IDs. Use the *.example files as templates.
src/config.yaml
src/state.json
.vscode/mcp.json
deployments/
.azure/

# Rayfin app (app-v2/) — written by `rayfin up`, all contain workspace / item / capacity GUIDs.
# The leak guard is an allow-list on GUIDs, so any of these in a commit fails CI on a public repo.
app-v2/rayfin/.env
app-v2/rayfin/.deployments.json
app-v2/dist/
**/.env.local

# Optional local deny-list for .github/scripts/check_client_leak.py (one literal per line).
# It must never be committed: a public file listing client names is itself the leak.
# In CI the same list comes from the CLIENT_DENYLIST secret.
.clientdeny

# (The *.example files ARE committed: src/config.example.yaml, src/state.example.json, .vscode/mcp.example.json)
